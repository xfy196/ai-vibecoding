#pragma once

// 可选：把 WiFi 账号直接编译进固件当默认值。
// 平时不用动它 —— 第一次上电设备会开热点，用手机网页配网就行，
// 配好的账号存在 NVS 里，优先级高于这里的值。
//
// 想用这个文件：
//   cp src/secrets.h.example src/secrets.h
//   secrets.h 已在 .gitignore 里，不会被提交。
// 只支持 2.4GHz 热点（ESP32-C3 没有 5GHz）。

#define WIFI_SSID     "your-wifi-2.4g"
#define WIFI_PASSWORD "your-password"
