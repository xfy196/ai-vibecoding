  "lyrics": [
    { "t": 0.5, "text": "我们之间的回忆", "keyword": "回忆" },
    { "t": 3.49, "text": "全部都小心地收集", "keyword": "收集" },
    { "t": 6.48, "text": "我总是偷偷地哭泣", "keyword": "哭泣" },
    { "t": 9.47, "text": "像倦鸟失了归期", "keyword": "倦鸟" },
    { "t": 12.45, "text": "但愿我相信的爱情", "keyword": "爱情" },
    { "t": 15.2, "text": "结局紧握在我手心", "keyword": "紧握" },
    { "t": 18.1, "text": "时光匆匆却没有遗失过去", "keyword": "时光" },
    { "t": 22.36, "text": "希望我们有光明的未来", "keyword": "光明" },
    { "t": 26.94, "text": "还有能够装下星空的期待", "keyword": "星空" },
    { "t": 34.05, "text": "可现实为何让我感到如此懈怠", "keyword": "现实" },
    { "t": 37.1, "text": "总怀念相遇时我们无视落叶和人海", "keyword": "人海" },
    { "t": 40.15, "text": "是你让我勇敢不再像颗尘埃", "keyword": "尘埃" },
    { "t": 43.2, "text": "是你常帮我照料装着梦的盆栽", "keyword": "盆栽" },
    { "t": 46.25, "text": "每一天我们都是如此愉快", "keyword": "愉快" },
    { "t": 49.3, "text": "一直到天色渐晚看着落日无奈离开", "keyword": "落日" },
    { "t": 52.45, "text": "我知道你爱集邮爱笑甚至爱发呆", "keyword": "集邮" },
    { "t": 55.6, "text": "我知道你怕草虫还有夜晚的妖怪", "keyword": "妖怪" },
    { "t": 58.45, "text": "我喜欢你有一点心不在焉的状态", "keyword": "心不在焉" }
