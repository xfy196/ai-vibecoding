  "lyrics": [
    { "t": 21.961, "text": "拦路雨偏似雪花 饮泣的你冻吗", "keyword": "雪花" },
    { "t": 26.464, "text": "这风褛我给你磨到有襟花", "keyword": "风褛" },
    { "t": 31.023, "text": "连调了职也不怕 怎么始终牵挂", "keyword": "牵挂" },
    { "t": 35.618, "text": "苦心选中今天想车你回家", "keyword": "回家" },
    { "t": 40.181, "text": "原谅我不再送花 伤口应要结疤", "keyword": "结疤" },
    { "t": 44.739, "text": "花瓣铺满心里坟场才害怕", "keyword": "坟场" },
    { "t": 49.337, "text": "如若你非我不嫁 彼此终必火化", "keyword": "火化" },
    { "t": 53.878, "text": "一生一世等一天需要代价", "keyword": "代价" },
    { "t": 58.438, "text": "谁都只得那双手靠拥抱亦难任你拥有", "keyword": "拥有" },
    { "t": 63.612, "text": "要拥有必先懂失去怎接受", "keyword": "失去" },
    { "t": 68.177, "text": "曾沿着雪路浪游 为何为好事泪流", "keyword": "雪路" },
    { "t": 72.733, "text": "谁能凭爱意要富士山私有", "keyword": "私有" },
    { "t": 77.292, "text": "何不把悲哀感觉假设是来自你虚构", "keyword": "虚构" },
    { "t": 81.912, "text": "试管里找不到它染污眼眸", "keyword": "试管" },
    { "t": 86.405, "text": "前尘硬化像石头 随缘地抛下便逃走", "keyword": "石头" },
    { "t": 94.143, "text": "我绝不罕有 往街里绕过一周", "keyword": "罕有" },
    { "t": 98.559, "text": "我便化乌有", "keyword": "乌有" },
    { "t": 102.64, "text": "情人节不要说穿 只敢抚你发端", "keyword": "发端" },
    { "t": 107.193, "text": "这种姿态可会令你更心酸", "keyword": "心酸" },
    { "t": 111.795, "text": "留在汽车里取暖 应该怎么规劝", "keyword": "取暖" },
    { "t": 116.376, "text": "怎么可以将手腕忍痛划损", "keyword": "划损" },
    { "t": 120.953, "text": "人活到几岁算短 失恋只有更短", "keyword": "更短" },
    { "t": 125.501, "text": "归家需要几里路谁能预算", "keyword": "几里路" },
    { "t": 130.088, "text": "忘掉我跟你恩怨 樱花开了几转", "keyword": "樱花" },
    { "t": 134.697, "text": "东京之旅一早比一世遥远", "keyword": "东京" },
